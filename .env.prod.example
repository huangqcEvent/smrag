# 使用域名时填写实际域名，例如 rag.example.com，Caddy 会自动申请 HTTPS 证书。
# 仅通过服务器 IP 验证时填写 :80。
DOMAIN=:80

POSTGRES_DB=smrag
POSTGRES_USER=fundrag
POSTGRES_PASSWORD=

MINIO_ROOT_USER=fundrag-minio
MINIO_ROOT_PASSWORD=
SMRAG_STORAGE_MINIO_BUCKET_NAME=fundrag-document

# 运行以下命令生成：
# docker run --rm apache/kafka:3.9.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# 至少 32 字节，推荐使用：openssl rand -base64 48
SMRAG_SECURITY_JWT_SECRET_KEY=
# 首次启动时用于创建或解锁全局管理员；初始化后不会覆盖后台修改的新密码。
SMRAG_BOOTSTRAP_ADMIN_USERNAME=admin
SMRAG_BOOTSTRAP_ADMIN_PASSWORD=
DASHSCOPE_API_KEY=

# 可按服务器内存调整；4C8G 机器建议保持默认值。
BACKEND_JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError"
BACKUP_RETENTION_DAYS=7
